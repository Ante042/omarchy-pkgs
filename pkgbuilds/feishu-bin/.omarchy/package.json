{
  "source": "local",
  "auto_merge": true,
  "release_ring": "fast",
  "upstream": {
    "watch": {
      "regex": "https://www.feishu.cn/api/downloads",
      "pattern": "^(?=.*\"Linux_deb_x64\":\\{\"download_link\":\"https://sf3-cn\\.feishucdn\\.com/obj/ee-appcenter/(?P<x86_64>[0-9a-f]{8})/Feishu-linux_x64-(?P<version>[0-9]+(?:\\.[0-9]+)+)\\.deb\")(?=.*\"Linux_deb_arm\":\\{\"download_link\":\"https://sf3-cn\\.feishucdn\\.com/obj/ee-appcenter/(?P<aarch64>[0-9a-f]{8})/Feishu-linux_arm64-(?P=version)\\.deb\")",
      "variables": {
        "_hash_x86_64": "{x86_64}",
        "_hash_aarch64": "{aarch64}"
      }
    }
  }
}
